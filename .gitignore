# Gitignore for portfolio static site

# Environment files — never commit secrets
.env
.env.local
.env*.local
*.env

# Key/cert files
*.pem
*.key
*.p12
*.pfx
*.secret

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Server config backups
*.bak
*.bak.*

# Editor directories
.vscode/
.idea/

# Build artifacts
dist/
build/
